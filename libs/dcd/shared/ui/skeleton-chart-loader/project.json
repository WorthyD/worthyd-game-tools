{
  "name": "shared-ui-skeleton-chart-loader",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dcd/shared/ui/skeleton-chart-loader/src",
  "prefix": "dcd",
  "projectType": "library",
  "tags": ["type:ui"],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "libs/dcd/shared/ui/skeleton-chart-loader/.storybook",
        "browserTarget": "shared-ui-skeleton-chart-loader:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/shared-ui-skeleton-chart-loader",
        "configDir": "libs/dcd/shared/ui/skeleton-chart-loader/.storybook",
        "browserTarget": "shared-ui-skeleton-chart-loader:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c libs/dcd/shared/ui/skeleton-chart-loader/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shared-ui-skeleton-chart-loader:build-storybook",
        "staticFilePath": "dist/storybook/shared-ui-skeleton-chart-loader"
      },
      "configurations": {
        "ci": {
          "buildTarget": "shared-ui-skeleton-chart-loader:build-storybook:ci"
        }
      }
    }
  }
}
