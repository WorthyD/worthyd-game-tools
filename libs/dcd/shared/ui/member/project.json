{
  "name": "shared-ui-member",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/dcd/shared/ui/member/src",
  "prefix": "dcd",
  "projectType": "library",
  "tags": ["type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/dcd/shared/ui/member/jest.config.ts",
        "tsConfig": "libs/dcd/shared/ui/member/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/dcd/shared/ui/member/.storybook",
        "browserTarget": "shared-ui-member:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/shared-ui-member",
        "configDir": "libs/dcd/shared/ui/member/.storybook",
        "browserTarget": "shared-ui-member:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "libs/dcd/shared/ui/member/cypress.config.ts",
        "testingType": "component",
        "skipServe": true,
        "devServerTarget": "destiny-clan-dashboard:build"
      }
    }
  }
}
